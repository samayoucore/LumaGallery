# Luma Gallery repository — version-control ONLY the custom theme and plugin.
# Everything else under wp-content (uploads, default themes/plugins, etc.) is ignored.

/*
!/.gitignore
!/README.md
!/plugins/
!/themes/
!/LumaLocal/

# Plugins: only the Luma Core plugin.
/plugins/*
!/plugins/luma-core/

# Themes: only the Luma Gallery theme.
/themes/*
!/themes/LumaGallery/

# LumaLocal (static, no-WP build of the site): never its node_modules.
/LumaLocal/node_modules/
